  ],
  "trust_tier_actions": {
    "T1": ["push_branch", "create_draft_pr", "post_comment", "add_label"],
    "T2": ["push_branch", "create_draft_pr", "mark_pr_ready", "post_comment", "add_label"],
    "T3": ["push_branch", "create_draft_pr", "mark_pr_ready", "post_comment", "add_label", "merge_pr", "enqueue_pr"],
    "T4": ["push_branch", "create_draft_pr", "mark_pr_ready", "post_comment", "add_label", "merge_pr", "enqueue_pr"]
  },
  "trust_tier_merge_scope": {
    "T1": "none",
    "T2": "none",
    "T3": "merge_paths_only (requires frozen WORKFLOW.md merge_paths non-empty, all touched files matching merge_paths, AND live pre-send server_target_branch_constraint verification)",
    "T4": "all_project_allowed_paths (requires passing non-empty write_scope + hard-stop + dependency-lock gates AND live pre-send server_target_branch_constraint verification)"
  },
  "server_target_branch_constraint": {
    "enqueue_pr": "Re-verified immediately before send across ALL ACTIVE repository rulesets, organization rulesets, AND fully paginated classic branchProtectionRules: because GraphQL BranchProtectionRule does not expose a Merge Queue toggle, if ANY classic rule pattern could match a branch other than exact authorized_base_ref unless pattern is an exact literal branch verified via repository.mergeQueue(branch: pattern) == null (or if any source is unreadable/incomplete or enables a second Merge Queue branch), immediately cap at T2 Ready-only",
    "merge_pr": "Requires merge_pr_requires_separate_merge_token=true and live pre-send verification that ACTIVE rulesets/classic protection enforced against the merge token identity itself (no actor/role/team/app/PR bypass; isAdminEnforced=true where classic rules apply) block merges into EVERY branch except exact authorized_base_ref; otherwise cap at T2 Ready-only"
  },
  "external_op_statuses": [
    "prepared_local",
    "aborted_pre_send",
    "in_flight",
    "unknown_paused",
    "succeeded_verified",
    "superseded_by_pr_merge",
    "superseded_by_retry",
    "not_executed",
    "rolled_back_to_draft",
    "merged_before_revoke",
    "diverged_needs_human"
  ],
  "one_mutation_per_op_id": true,
  "action_transport_map": {
    "push_branch": "git --git-dir=<EPHEMERAL_PUSH_DIR> push --porcelain --force-with-lease=<authorized_head_ref>:<old_oid> <https_url> <C>:<authorized_head_ref> (strictly from frozen run_claims.authorized_head_ref != authorized_base_ref)",
    "create_draft_pr": "GraphQL createPullRequest(input={repositoryId, baseRefName, headRefName, title, body, draft: true})",
    "mark_pr_ready": "GraphQL markPullRequestReadyForReview(input={pullRequestId})",
    "post_comment": "GraphQL addComment(input={subjectId, body}) with Ref-ID: ap-<hmac>",
    "add_label": "GraphQL addLabelsToLabelable(input={labelableId, labelIds})",
    "merge_pr": "GraphQL mergePullRequest(input={pullRequestId, expectedHeadOid: C, mergeMethod: <project_merge_method>})",
    "enqueue_pr": "GraphQL enqueuePullRequest(input={pullRequestId, expectedHeadOid: C})",
    "convert_pr_to_draft": "GraphQL convertPullRequestToDraft(input={pullRequestId})",
    "dequeue_pr": "GraphQL dequeuePullRequest(input={id: pullRequestId})",
    "disable_pr_automerge": "GraphQL disablePullRequestAutoMerge(input={pullRequestId})"
  },
  "forbidden_graphql_mutations": [
    "enablePullRequestAutoMerge"
  ],
  "supervisor_admin_actions": [
    "convert_pr_to_draft",
    "dequeue_pr",
    "disable_pr_automerge"
  ],
  "expected_raw_invalid_path_samples": [
    "src\\evil.py",
    "apps\\web\\index.ts",
    "src/../secret.txt",
    "src/bad\nname.py"
  ],
