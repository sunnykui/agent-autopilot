{
  "schema_version": 17,
  "require_systemd_linger": true,
  "merge_pr_requires_separate_merge_token": true,
  "basenames_case_insensitive": true,
  "anchored_case_sensitive_linux": true,
  "forbid_literal_backslash_and_control_chars": true,
  "default_branch_prefix": "agent/",
  "cleanup_unit_limits": {
    "timeout_start_sec": 15,
    "runtime_max_sec": 240,
    "timeout_stop_sec": 15,
    "wrapper_sigterm_sec": 265,
    "wrapper_kill_after_sec": 5
  },
  "chef_pipeline": {
    "roles": ["scout", "writer", "referee"],
    "cross_family_referee_map": {
      "codex": "claude",
      "claude": "codex",
      "agy": "claude"
    },
    "configurable_models": {
      "claude_scout": "claude-sonnet-5-5",
      "claude_writer": "claude-sonnet-5-5",
      "claude_referee": "claude-fable-5-2",
      "codex_scout": "gpt-6.2-sol",
      "codex_writer": "gpt-6.2-sol",
      "codex_referee": "gpt-6.2-astra",
      "agy_scout": "gemini-4-neon-medium",
      "agy_writer": "gemini-4-neon-high",
      "agy_referee": "gemini-4-neon-high",
      "visual_inspector": "gpt-6.1-terra"
    },
    "enable_ui_verify_default": false,
    "max_review_rounds": 3,
    "exhausted_review_terminal": "needs-human",
    "publish_requires_current_candidate_verify_and_review_receipts": true,
    "initial_max_in_progress": 1,
    "staircase_concurrency_steps": [1, 2, 3],
    "staircase_min_clean_runs": 10,
    "staircase_maturity_hours": 48,
    "staircase_requires_human_approval": true,
    "authoritative_policy_file": "~/.config/agent-autopilot/projects/<project_id>/WORKFLOW.md",
    "advisory_only_dir": "~/.local/state/agent-autopilot/advisory/<project_id>/",
    "advisory_excluded_from_referee_and_visual": true,
    "max_pitfall_rule_chars": 200,
    "required_fill_in_schemas": {
      "scout": ["root_cause", "target_area", "exemplar_files", "dod_check", "ui_verify_needed", "uncertainties"],
      "writer": ["summary_le_300_chars", "changed_files", "executed_checks", "uncertainties"],
      "referee": ["verdict", "round_index", "defect_count", "three_col_defects", "uncertainties"]
    },
    "pitfall_routing_targets": {
      "project_advisory_auto": "~/.local/state/agent-autopilot/advisory/<project_id>/PITFALLS.md",
      "global_proposal_human_gated": "~/.local/state/agent-autopilot/proposals/<sig>/LESSONS_LEARNED.patch",
      "executable_gate_proposal_human_gated": "~/.local/state/agent-autopilot/proposals/<sig>/gate_patch.json"
    }
  },
  "host_binary_slots": {
    "ap_sandbox_init": "Static C initializer binary (distinct inode from ap_safe_sh)",
    "ap_safe_sh": "Static C non-blocking shell proxy client (bound to /usr/bin/{bash,sh,dash}; host shells are NEVER mounted in model_ring)",
    "codex_cli": "Resolved host codex static-pie ELF binary",
    "claude_cli": "Resolved host claude ELF binary (invoked with --setting-sources user --strict-mcp-config --exclude-dynamic-system-prompt-sections; dynamic loader + 0644 .so libs when dynamic_elf_libs=true)",
    "agy_cli": "Resolved host agy ELF binary (invoked with --disable-slash-commands and structured stream-json/json print mode; dynamic loader + 0644 .so libs when dynamic_elf_libs=true)"
  },
  "llm_proxy_allowlist_domains": [
    "api.anthropic.com",
    "claude.ai",
    "api.claude.ai",
    "platform.claude.com",
    "api.openai.com",
    "chatgpt.com",
    "auth.openai.com"
  ],
  "family_llm_proxy_allowlist_domains": {
    "claude": [
      "api.anthropic.com",
      "claude.ai",
      "api.claude.ai",
      "platform.claude.com"
    ],
    "codex": [
      "api.openai.com",
      "chatgpt.com",
      "auth.openai.com"
    ],
    "agy": [
      "daily-cloudcode-pa.googleapis.com",
      "cloudcode-pa.googleapis.com",
      "aicode.googleapis.com"
    ]
  },
  "agy_permission_deny": [
    "read_file(/home/sandbox/.gemini)",
    "write_file(/home/sandbox/.gemini)",
    "read_file(~/.gemini)",
    "write_file(~/.gemini)",
    "write_file(.agents)",
    "write_file(.agent)",
    "write_file(_agent)",
    "write_file(_agents)",
    "write_file(.gemini)",
    "read_file(/proc)",
    "write_file(/proc)",
    "read_file(/run/ap)",
    "write_file(/run/ap)",
    "mcp(*)",
    "read_url(*)",
    "execute_url(*)"
  ],
  "claude_permission_deny": [
    "Read(~/.claude/**)",
    "Edit(~/.claude/**)",
    "Read(//home/*/.claude/**)",
    "Edit(//home/*/.claude/**)",
    "Read(//proc/**)",
    "Edit(//proc/**)"
  ],
  "role_matrix": {
    "codex:issue_model": {
      "binary_mounts": {
        "/usr/local/bin/ap-sandbox-init": "ap_sandbox_init",
        "/usr/local/bin/codex": "codex_cli",
        "/usr/bin/bash": "ap_safe_sh",
        "/usr/bin/sh": "ap_safe_sh",
        "/usr/bin/dash": "ap_safe_sh"
      },
      "landlock_allow_exec": [
        "/usr/local/bin/codex",
        "/usr/local/bin/codex-code-mode-host",
        "/usr/bin/bash",
        "/usr/bin/sh",
        "/usr/bin/dash"
      ],
      "dynamic_elf_libs": false,
      "mount_tool_sock": true,
      "readonly_worktree_dot_git": true,
      "writable_mounts": ["sandbox_home", "shared_tmp", "shell_snapshots", "worktree", "outbox"]
    },
    "codex:readonly_model": {
      "binary_mounts": {
        "/usr/local/bin/ap-sandbox-init": "ap_sandbox_init",
        "/usr/local/bin/codex": "codex_cli"
      },
      "landlock_allow_exec": [
        "/usr/local/bin/codex",
        "/usr/local/bin/codex-code-mode-host"
      ],
      "dynamic_elf_libs": false,
      "mount_tool_sock": false,
      "readonly_worktree_dot_git": false,
      "readonly_review_bundle_mount": "/ap-review-bundle",
      "verdict_handoff_channel": "outbox_json_validated_by_host",
      "writable_mounts": ["sandbox_home", "outbox"]
    },
    "claude:issue_model": {
      "binary_mounts": {
        "/usr/local/bin/ap-sandbox-init": "ap_sandbox_init",
        "/usr/local/bin/claude": "claude_cli",
        "/usr/bin/bash": "ap_safe_sh",
        "/usr/bin/sh": "ap_safe_sh",
        "/usr/bin/dash": "ap_safe_sh"
      },
      "landlock_allow_exec": [
        "/usr/local/bin/claude",
        "/usr/lib64/ld-linux-x86-64.so.2",
        "/usr/bin/bash",
        "/usr/bin/sh",
        "/usr/bin/dash"
      ],
      "claude_cli_flags": ["--permission-mode", "bypassPermissions", "--setting-sources", "user", "--strict-mcp-config", "--exclude-dynamic-system-prompt-sections"],
      "claude_tools": ["Bash", "Read", "Edit", "Write", "Glob", "Grep"],
      "dynamic_elf_libs": true,
      "mount_tool_sock": true,
      "readonly_worktree_dot_git": true,
      "writable_mounts": ["sandbox_home", "shared_tmp", "shell_snapshots", "worktree", "outbox"]
    },
    "claude:readonly_model": {
      "binary_mounts": {
        "/usr/local/bin/ap-sandbox-init": "ap_sandbox_init",
        "/usr/local/bin/claude": "claude_cli"
      },
      "landlock_allow_exec": [
        "/usr/local/bin/claude",
        "/usr/lib64/ld-linux-x86-64.so.2"
      ],
      "claude_cli_flags": ["--setting-sources", "user", "--strict-mcp-config", "--exclude-dynamic-system-prompt-sections"],
      "claude_tools": ["Read", "Glob", "Grep"],
      "dynamic_elf_libs": true,
      "mount_tool_sock": false,
      "readonly_worktree_dot_git": false,
      "readonly_review_bundle_mount": "/ap-review-bundle",
      "verdict_handoff_channel": "stdout_json_validated_by_host",
      "writable_mounts": ["sandbox_home", "outbox"]
    },
    "agy:issue_model": {
      "binary_mounts": {
        "/usr/local/bin/ap-sandbox-init": "ap_sandbox_init",
        "/usr/local/bin/agy": "agy_cli",
        "/usr/bin/bash": "ap_safe_sh",
        "/usr/bin/sh": "ap_safe_sh",
        "/usr/bin/dash": "ap_safe_sh"
      },
      "landlock_allow_exec": [
        "/usr/local/bin/agy",
        "/usr/lib64/ld-linux-x86-64.so.2",
        "/usr/bin/bash",
        "/usr/bin/sh",
        "/usr/bin/dash"
      ],
      "agy_cli_flags": ["--mode", "accept-edits", "--disable-slash-commands"],
      "agy_permission_allow": ["command(*)", "read_file(/tmp)", "write_file(/tmp)"],
      "dynamic_elf_libs": true,
      "mount_tool_sock": true,
      "readonly_worktree_dot_git": true,
      "writable_mounts": ["sandbox_home", "shared_tmp", "shell_snapshots", "worktree", "outbox"]
    },
    "agy:readonly_model": {
      "binary_mounts": {
        "/usr/local/bin/ap-sandbox-init": "ap_sandbox_init",
        "/usr/local/bin/agy": "agy_cli"
      },
      "landlock_allow_exec": [
        "/usr/local/bin/agy",
        "/usr/lib64/ld-linux-x86-64.so.2"
      ],
      "agy_cli_flags": ["--mode", "plan", "--disable-slash-commands"],
      "agy_permission_allow": ["read_file(/ap-review-bundle)"],
      "agy_extra_permission_deny": ["write_file(*)", "command(*)"],
      "dynamic_elf_libs": true,
      "mount_tool_sock": false,
      "readonly_worktree_dot_git": false,
      "readonly_review_bundle_mount": "/ap-review-bundle",
      "verdict_handoff_channel": "stdout_json_validated_by_host",
      "writable_mounts": ["sandbox_home"]
    }
  },
  "execution_rings": {
    "tool_ring": {
      "network": "none (--unshare-net)",
      "mount_sandbox_home": false,
      "readonly_mounts": ["/usr", "/etc/basic", "worktree/.git", "MANAGED_GITDIR", "REPO_MAIN/.git/objects", "trusted_base_cache", "shell_snapshots"],
      "writable_mounts": ["worktree", "ephemeral_tool_cache", "shared_tmp"],
      "cwd_policy": "realpath(req_cwd) must be inside realpath(worktree)"
    },
    "git_ops_ring": {
      "network": "none (--unshare-net)",
      "mount_sandbox_home": false,
      "mount_repo_main_config": false,
      "git_optional_locks": 0,
      "sampling_mode_readonly_mounts": ["/usr", "MANAGED_GITDIR", "REPO_MAIN/.git/objects", "worktree"],
      "sampling_mode_writable_mounts": ["run_dir/scratch-objects", "run_dir/stage_dir"],
      "cleanup_mode_writable_mounts": ["MANAGED_GITDIR", "worktree"]
    },
    "verify_ring": {
      "network": "none (--unshare-net; optional loopback-only headless browser inside verify_ring when enable_ui_verify=true)",
      "mount_sandbox_home": false,
      "mount_ephemeral_tool_cache": false,
      "forbid_hardlinks_to_clean_tree": true,
      "readonly_mounts": ["/proc", "/dev", "/usr", "/etc/basic", "CLEAN_TREE", "trusted_base_cache"],
      "optional_ui_readonly_mounts": ["/opt/google/chrome"],
      "writable_mounts": ["run_dir/verify-out-C"]
    }
  },
  "global_hard_stop_anchored": [
