    "scripts/autopilot_*.py",
    "scripts/autopilot_*.sh",
    "scripts/issue_autopilot.py",
    ".github/**",
    ".gitmodules",
    ".gitattributes",
    "**/.gitattributes",
    "CODEOWNERS",
    "**/CODEOWNERS",
    ".claude/**",
    "**/.claude/**",
    ".codex/**",
    "**/.codex/**",
    ".agents/**",
    "**/.agents/**",
    ".agent/**",
